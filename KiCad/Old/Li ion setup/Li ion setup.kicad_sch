	)
	(text "Solar Charge 150 / 45\n\nRated Battery Voltage: 12 / 24 / 48V\n\nMax PV Voltage: 150V\nMax PV Short Circuit: 50A\n\nMax Battery Voltage: 48V  (51.2V exceeds)\nMax Battery Charge Current: 45A\nNominal PV Power: 48V * 45A = 2600W\n"
		(exclude_from_sim no)
		(at 106.68 142.494 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9812805f-be64-4a21-a82d-b5f263201508")
	)
	(text "Solar Panel Array\n\nMax Voltage: 	45V * 2 = 90V\nMax Current: 	10.11A * 2 = 20.22A\nShort Circuit:	10.77A * 2 = 21.54A\nMax Power: 		90V * 20.22A = 1819.8W\n				(455W + 5W) * 4 = 1840W"
		(exclude_from_sim no)
		(at 28.702 91.694 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b60ca378-9829-43e9-bde2-fb27941b525b")
	)
	(text "Power Usage\n\nMaximum Current Draw:	50A+83A=133A (Exceeds MPPT 45A)\nSensors & MCB: 			< 1A\nMax Power Draw: 		(50A*51.2V)+4000W=6560W\n						(Exceeds Solar Panel & MPPT Max)"
		(exclude_from_sim no)
		(at 198.882 95.758 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
