		(uuid "dda4925d-4dc1-446b-ab7e-139a5ec7cbb1")
	)
	(text "Battery Array For Li-ion\n\nDischarge Voltage:	 	25.9V*2=51.8V\nMax Charging Voltage: 	29.05V*2=58.1V \nMax Current Discharge: 	180A\nMax Current Charge: 	100A"
